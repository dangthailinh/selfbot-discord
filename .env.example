# Không đặt key hoặc token thật trong Git.
DISCORD_TOKEN_1=replace_with_discord_token_1
DISCORD_TOKEN_2=replace_with_discord_token_2

GEMINI_API_KEYS=replace_with_new_key_1,replace_with_new_key_2
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MENTION_ENABLED=true
GEMINI_MAX_HISTORY_TURNS=8
GEMINI_MAX_OUTPUT_TOKENS=256
GEMINI_MAX_KEYS_PER_REQUEST=3
GEMINI_DAILY_QUOTA_COOLDOWN_MS=21600000
GEMINI_USER_COOLDOWN_MS=2500
GEMINI_REPLY_DELAY_MIN_MS=500
GEMINI_REPLY_DELAY_MAX_MS=1400

# Groq chỉ được gọi khi Gemini không còn key khả dụng hoặc bị từ chối.
GROQ_API_KEYS=replace_with_groq_key
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MAX_KEYS_PER_REQUEST=2
GROQ_DAILY_QUOTA_COOLDOWN_MS=21600000

# TokenRouter Qwen chỉ được gọi khi Gemini và Groq không khả dụng.
TOKENROUTER_API_KEYS=replace_with_tokenrouter_key
TOKENROUTER_MODEL=qwen/qwen3.8-max-free
TOKENROUTER_MAX_KEYS_PER_REQUEST=2
TOKENROUTER_DAILY_QUOTA_COOLDOWN_MS=21600000

# Selfchat: nói ít hơn, xen kẽ reaction/sticker/emoji.
SELFCHAT_DELAY_MIN_MS=25000
SELFCHAT_DELAY_MAX_MS=55000
SELFCHAT_LOCAL_REPLY_CHANCE_PERCENT=35
SELFCHAT_MAX_PAIR_STREAK_TURNS=6
SELFCHAT_REPLY_CHANCE_PERCENT=18
SELFCHAT_CONTEXT_MESSAGES=6
SELFCHAT_REACTION_CHANCE_PERCENT=12
SELFCHAT_STICKER_CHANCE_PERCENT=5
SELFCHAT_EMOJI_MESSAGE_CHANCE_PERCENT=6
SELFCHAT_TEXT_EMOJI_CHANCE_PERCENT=6
SELFCHAT_SWEAR_CHANCE_PERCENT=18
SELFCHAT_SILENT_TURN_PERCENT=10
SELFCHAT_TYPING_MIN_MS=700
SELFCHAT_TYPING_MAX_MS=6500
SELFCHAT_MEDIUM_MESSAGE_CHANCE_PERCENT=22
SELFCHAT_LONG_MESSAGE_CHANCE_PERCENT=10
SELFCHAT_MEDIA_CHANCE_PERCENT=3
SELFCHAT_MEDIA_COOLDOWN_TURNS=28
SELFCHAT_MEDIA_MAX_BYTES=8000000

# Debate tự tắt upload media trong 6 giờ nếu Discord giới hạn upload của guild.
DEBATE_MEDIA_UPLOAD_COOLDOWN_MS=21600000
DEBATE_DEBUG_LOGS=false

# Debate VOZ: relay tuần tự Chuyện trò linh tinh, lưu tiến độ ở usedVozThreads.json.
DEBATEVOZ_POST_DELAY_MS=8000
DEBATEVOZ_THREAD_DELAY_MS=15000
DEBATEVOZ_REQUEST_DELAY_MS=1400
DEBATEVOZ_RSS_FALLBACK_MS=1800000
DEBATEVOZ_CATALOG_PAGES=5
DEBATEVOZ_REACTION_CHANCE_PERCENT=55
DEBATEVOZ_INLINE_EMOJI_CHANCE_PERCENT=22
DEBATEVOZ_MAX_REACTIONS_PER_POST=2
DEBATEVOZ_MAX_MEDIA_PER_POST=6
DEBATEVOZ_MEDIA_MAX_BYTES=8000000

# Snipe: giới hạn dữ liệu để việc xóa tin nhắn không làm nghẽn bot.
SNIPE_MAX_STORED_CHANNELS=500
